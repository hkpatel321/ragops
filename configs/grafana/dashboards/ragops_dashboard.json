{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "expr": "ALERTS{alertname=~\".+\"}",
        "hide": false,
        "iconColor": "#F2495C",
        "name": "Prometheus Active Alerts",
        "step": "1m",
        "tagKeys": "alertname,severity,category",
        "textFormat": "{{alertname}}: {{description}} (state={{alertstate}})",
        "titleFormat": "🚨 Prometheus Alert: {{alertname}}"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "expr": "ragops_rolling_faithfulness < 0.70",
        "hide": false,
        "iconColor": "#FF780A",
        "name": "Faithfulness Breach Alert",
        "step": "1m",
        "textFormat": "Rolling Faithfulness dropped below 0.70 threshold",
        "titleFormat": "⚠️ Low Faithfulness Breach"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "expr": "ragops_embedding_drift_detected > 0 or ragops_kb_index_stale > 0",
        "hide": false,
        "iconColor": "#E02F44",
        "name": "Drift & Staleness Events",
        "step": "1m",
        "textFormat": "Knowledge-base staleness or semantic embedding drift detected",
        "titleFormat": "📢 Drift / Staleness Alert"
      }
    ]
  },
